<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DeskIslet</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationManifest>../../native/core/core.manifest</ApplicationManifest>
    <ApplicationIcon>DeskIslet.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <Reference Include="ScreenRecorderLib"><HintPath>../vendor/recorder-x64/ScreenRecorderLib.dll</HintPath></Reference>
    <Reference Include="PresentationCore" /><Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" /><Reference Include="System.Xaml" />
    <Reference Include="System.Windows.Forms" /><Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" /><Reference Include="System.Security" />
    <Reference Include="System.Runtime.Serialization" /><Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <EmbeddedResource Include="Shell.xaml" LogicalName="Shell.xaml" />
    <EmbeddedResource Include="Recorder.xaml" LogicalName="Recorder.xaml" />
  </ItemGroup>
</Project>
