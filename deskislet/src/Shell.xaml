<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="桌屿 · 分区管理" Width="390" Height="660" MinWidth="300" MinHeight="240"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Background="Transparent" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" Foreground="#FFF5F5F7">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#FFF5F5F7"/>
      <Setter Property="Background" Value="#19FFFFFF"/>
      <Setter Property="BorderBrush" Value="#398E8E93"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Face" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Background" Value="#FF49494D"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF83B9FF"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="1" Background="#709A9AA0" CornerRadius="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
        </Track>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border BorderBrush="#608E8E93" BorderThickness="1" CornerRadius="15">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint=".7,1">
      <GradientStop Color="#F32E2E32" Offset="0"/><GradientStop Color="#F7232327" Offset=".42"/><GradientStop Color="#F51C1C1E" Offset="1"/>
    </LinearGradientBrush></Border.Background>
    <Grid Margin="16,12,16,10">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid x:Name="Header" Background="Transparent" Margin="0,0,0,13">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Border Width="34" Height="34" Background="#307D7D86" CornerRadius="10" VerticalAlignment="Center">
          <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24"><Path Stroke="#FFF5F5F7" StrokeThickness="1.7" StrokeLineJoin="Round" Data="M2,8 L12,3 22,8 12,13 Z M2,12 L12,17 22,12 M2,16 L12,21 22,16"/></Canvas></Viewbox>
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="桌屿" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="分区管理" FontSize="11" Foreground="#FFBCBCC2"/></StackPanel>
        <Button x:Name="Add" Grid.Column="2" VerticalAlignment="Center" Content="＋ 分区" Margin="0,0,5,0" ToolTip="新建项目分区"/>
        <Button x:Name="More" Grid.Column="3" VerticalAlignment="Center" Padding="8,5" Content="···" ToolTip="规则与桌面选项"/>
      </Grid>
      <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
        <StackPanel x:Name="Sections" Margin="0,0,3,0"/>
      </ScrollViewer>
      <Border x:Name="Notice" Grid.Row="2" Visibility="Collapsed" Margin="0,6,0,0" CornerRadius="8" Background="#FF38383D" Padding="10">
        <StackPanel><TextBlock x:Name="NoticeText" TextWrapping="Wrap"/><WrapPanel Margin="0,6,0,0">
          <Button x:Name="Learn" Content="记住规则…" Margin="0,0,6,0"/><Button x:Name="Dismiss" Content="关闭提示"/>
        </WrapPanel></StackPanel>
      </Border>
      <DockPanel Grid.Row="3" Margin="2,9,2,0"><Ellipse Width="6" Height="6" Fill="#FF64D2FF" Margin="0,0,7,0"/><TextBlock x:Name="Status" FontSize="11" Foreground="#FFAFAFB6" TextTrimming="CharacterEllipsis"/></DockPanel>
    </Grid>
  </Border>
</Window>
